# Server-only. Owner connection string for migrations and tests.
# NEVER given a NEXT_PUBLIC_ prefix and never imported by app code.
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Public by design (endpoint URLs, not credentials). Safe to expose because
# every request requires a valid session JWT and is enforced by grants + RLS.
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-your-endpoint.neonauth.region.aws.neon.tech/neondb/auth"
NEXT_PUBLIC_NEON_DATA_API_URL="https://ep-your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1"
